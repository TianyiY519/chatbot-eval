# Copy to .env and uncomment ONE provider block. The same setting drives
# Ragas generation (02, 03) and the DeepEval judge (05).
# Leave unused lines commented: DeepEval reads .env itself and rejects blank values.

# --- OpenRouter (recommended; Jorge provides the key) ---
LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# Development (free):  GEN_MODEL=google/gemma-4-31b-it:free  JUDGE_MODEL=google/gemma-4-31b-it:free
# Final dataset run:   GEN_MODEL=anthropic/claude-sonnet-5.5 JUDGE_MODEL=anthropic/claude-sonnet-5.5
# GEN_MODEL=
# JUDGE_MODEL=
# EMBED_MODEL=                  # default openai/text-embedding-3-small

# --- Ollama (local, free, nothing leaves the machine) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434   # models: qwen3:14b + nomic-embed-text

# --- Gemini free tier (public documents only) ---
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=

# --- Azure OpenAI ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_GEN_DEPLOYMENT=
# AZURE_JUDGE_DEPLOYMENT=
# AZURE_EMBED_DEPLOYMENT=

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
